# Routing SPA (React Router) sur Apache/LiteSpeed.
# Sans ça : recharger /login, /dashboard... renvoie une 404 serveur
# ("The requested resource could not be found on this server").
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS. Sans cette redirection, ouvrir le site en http:// (ex. quand on
  # tape "livefx-trading.com" sans préfixe) reste en HTTP et le navigateur affiche
  # « Not secure ». On redirige tout le trafic HTTP vers HTTPS en 301.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Ne pas réécrire les fichiers/dossiers réels (assets, images, index.html...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Tout le reste est géré côté client par React Router
  RewriteRule . /index.html [L]
</IfModule>

# Ne jamais mettre index.html en cache : Safari iOS gardait une ancienne version
# pointant vers d'anciens fichiers JS (page blanche / comportements incohérents
# après une mise à jour). Les fichiers /assets/ sont hachés, donc cache long OK.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
