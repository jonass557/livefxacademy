# Port (Render le fournit automatiquement, laisser tel quel en local)
PORT=5000

# Connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/livefx_db?appName=livefx

# Secrets JWT (générer des chaînes aléatoires longues)
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue
JWT_REFRESH_SECRET=remplacez_par_une_autre_chaine_aleatoire_longue

# Cloudinary (upload vidéos / annonces)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# URL du frontend déployé (Vercel) — pour autoriser le CORS
# Exemple en production : https://livefxacademy.vercel.app
FRONTEND_URL=http://localhost:5173
